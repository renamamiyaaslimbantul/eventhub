{
    "name": "eventhub/backend",
    "description": "EventHub Backend API - Sistem Pendaftaran Event & Seminar Kampus",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EventHub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EventHub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8080 -t public public/router.php",
        "db:seed": "php database/seeders/seed.php",
        "test": "phpunit",
        "post-autoload-dump": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
